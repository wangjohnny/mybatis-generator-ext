CREATE SCHEMA PUBLIC AUTHORIZATION DBA
SET SCHEMA PUBLIC
CREATE MEMORY TABLE PUBLIC.USER(SID BIGINT PRIMARY KEY,USERNAME VARCHAR(50) NOT NULL,PASSWORD VARCHAR(60) NOT NULL,EMAIL VARCHAR(100),STATUS TINYINT DEFAULT 1,IS_DELETED TINYINT DEFAULT 0,DELETED_BY BIGINT DEFAULT NULL,DELETED_AT TIMESTAMP DEFAULT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,UPDATED_AT TIMESTAMP DEFAULT NULL,UNIQUE(USERNAME))
CREATE MEMORY TABLE PUBLIC.ROLE(SID BIGINT PRIMARY KEY,ROLE_NAME VARCHAR(50) NOT NULL,ROLE_CODE VARCHAR(50) NOT NULL,DESCRIPTION VARCHAR(255),IS_DELETED TINYINT DEFAULT 0,DELETED_BY BIGINT DEFAULT NULL,DELETED_AT TIMESTAMP DEFAULT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,UPDATED_AT TIMESTAMP DEFAULT NULL,UNIQUE(ROLE_NAME),UNIQUE(ROLE_CODE))
CREATE MEMORY TABLE PUBLIC.PERMISSION(SID BIGINT PRIMARY KEY,PERM_NAME VARCHAR(50) NOT NULL,PERM_KEY VARCHAR(100) NOT NULL,PERM_TYPE TINYINT NOT NULL,PATH VARCHAR(255),PARENT_SID BIGINT DEFAULT NULL,IS_DELETED TINYINT DEFAULT 0,DELETED_BY BIGINT DEFAULT NULL,DELETED_AT TIMESTAMP DEFAULT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,UPDATED_AT TIMESTAMP DEFAULT NULL,UNIQUE(PERM_KEY))
CREATE MEMORY TABLE PUBLIC.USER_ROLE(USER_SID BIGINT NOT NULL,ROLE_SID BIGINT NOT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(USER_SID,ROLE_SID))
CREATE MEMORY TABLE PUBLIC.ROLE_PERMISSION(ROLE_SID BIGINT NOT NULL,PERMISSION_SID BIGINT NOT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(ROLE_SID,PERMISSION_SID))
CREATE MEMORY TABLE PUBLIC.SALES_ORDER(ID BIGINT PRIMARY KEY,ORDER_NO VARCHAR(50) NOT NULL,STATUS TINYINT DEFAULT 1,IS_DELETED TINYINT DEFAULT 0,DELETED_BY BIGINT DEFAULT NULL,DELETED_AT TIMESTAMP DEFAULT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP)
CREATE MEMORY TABLE PUBLIC.IMPORT_ORDER(ID BIGINT PRIMARY KEY,IMPORT_TYPE VARCHAR(50),CUSTOMS_NO VARCHAR(50),IS_DELETED TINYINT DEFAULT 0,DELETED_BY BIGINT DEFAULT NULL,DELETED_AT TIMESTAMP DEFAULT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP)
CREATE MEMORY TABLE PUBLIC.EXPORT_ORDER(ID BIGINT PRIMARY KEY,EXPORT_TYPE VARCHAR(50),DESTINATION VARCHAR(100),IS_DELETED TINYINT DEFAULT 0,DELETED_BY BIGINT DEFAULT NULL,DELETED_AT TIMESTAMP DEFAULT NULL,CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP)
